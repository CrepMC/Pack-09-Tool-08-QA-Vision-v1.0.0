{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameReviewRecord",
  "type": "object",
  "required": [
    "frame_id",
    "timestamp",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "frame_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "number",
      "minimum": 0
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
