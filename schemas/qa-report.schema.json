{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/qa-report.schema.json",
  "title": "QAReport",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "artifact_version",
    "project_id",
    "status",
    "video_ref",
    "source_refs",
    "overall_result",
    "domain_scores",
    "issues",
    "passing_constraints",
    "correction_targets",
    "review_summary",
    "warnings"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "artifact_type": {
      "const": "QAReport"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_version": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "NEEDS_REVIEW",
        "APPROVED",
        "LOCKED"
      ]
    },
    "video_ref": {
      "type": "string"
    },
    "source_refs": {
      "type": "object",
      "required": [
        "product_dna",
        "creative_brief",
        "camera_plan",
        "motion_plan",
        "environment_plan",
        "cinematic_plan"
      ],
      "properties": {
        "product_dna": {
          "type": "string"
        },
        "creative_brief": {
          "type": "string"
        },
        "camera_plan": {
          "type": "string"
        },
        "motion_plan": {
          "type": "string"
        },
        "environment_plan": {
          "type": "string"
        },
        "cinematic_plan": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "overall_result": {
      "enum": [
        "PASS",
        "FAIL",
        "NEEDS_REVIEW",
        "UNKNOWN"
      ]
    },
    "domain_scores": {
      "type": "object",
      "required": [
        "product",
        "camera",
        "motion",
        "environment",
        "cinematic"
      ],
      "properties": {
        "product": {
          "$ref": "#/$defs/domainScore"
        },
        "camera": {
          "$ref": "#/$defs/domainScore"
        },
        "motion": {
          "$ref": "#/$defs/domainScore"
        },
        "environment": {
          "$ref": "#/$defs/domainScore"
        },
        "cinematic": {
          "$ref": "#/$defs/domainScore"
        }
      },
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "passing_constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/passingConstraint"
      }
    },
    "correction_targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/correctionTarget"
      }
    },
    "review_summary": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    }
  },
  "$defs": {
    "domainScore": {
      "type": "object",
      "required": [
        "score",
        "status",
        "blocking_issue_count",
        "major_issue_count",
        "confidence"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NEEDS_REVIEW",
            "UNKNOWN"
          ]
        },
        "blocking_issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "major_issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "type",
        "time_start",
        "time_end",
        "description"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "time_start": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "time_end": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "frame_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "required": [
        "issue_id",
        "domain",
        "issue_type",
        "severity",
        "blocking",
        "title",
        "description",
        "expected",
        "observed",
        "evidence",
        "recommended_target"
      ],
      "properties": {
        "issue_id": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "secondary_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issue_type": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "minor",
            "major",
            "critical"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "observed": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "recommended_target": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "passingConstraint": {
      "type": "object",
      "required": [
        "domain",
        "constraint_id",
        "description",
        "confidence"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "constraint_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "correctionTarget": {
      "type": "object",
      "required": [
        "target_id",
        "domain",
        "priority",
        "objective",
        "preserve_passing_constraints"
      ],
      "properties": {
        "target_id": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "objective": {
          "type": "string"
        },
        "issue_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserve_passing_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "do_not_change": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
